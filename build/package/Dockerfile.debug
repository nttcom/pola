# syntax=docker/dockerfile:1
# ---- builder stage ----
FROM golang:1.27.2@sha256:820153096fda4de6ac1b7194d12e416b7dd8f4e9a33d17e0345b111b945162d8 AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go install ./cmd/...

# ---- runtime stage ----
FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

LABEL org.opencontainers.image.authors="Motoki TAKENAKA <m.takenaka@ntt.com>, Wataru MISHIMA <w.mishima@ntt.com>"

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    ca-certificates bash-completion curl iproute2 iputils-ping net-tools vim \
 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /go/bin/pola /usr/local/bin/
COPY --from=builder /go/bin/polad /usr/local/bin/

# Enable bash completion for interactive shells
RUN cat >> /root/.bashrc <<'EOF'
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi
EOF

SHELL ["/bin/bash", "-c"]

# Add pola completion
RUN mkdir -p /usr/share/bash-completion/completions \
 && pola completion bash > /usr/share/bash-completion/completions/pola

# polad reads polad.yaml from the working directory (mounted at runtime).
WORKDIR /pola

# Override the arguments at runtime if a different config path is needed.
ENTRYPOINT ["polad"]
CMD ["-f", "polad.yaml"]
