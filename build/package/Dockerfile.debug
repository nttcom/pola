# syntax=docker/dockerfile:1
# ---- builder stage ----
FROM golang:1.26.5@sha256:ae5a2316d12f3e78fd99177dad452e6ad4f240af2d71d57b480c3477f250fec6 AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go install ./cmd/...

# ---- runtime stage ----
FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818

LABEL org.opencontainers.image.authors="Motoki TAKENAKA <m.takenaka@ntt.com>, Wataru MISHIMA <w.mishima@ntt.com>"

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    ca-certificates bash-completion curl iproute2 iputils-ping net-tools vim \
 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /go/bin/pola /usr/local/bin/
COPY --from=builder /go/bin/polad /usr/local/bin/

# Enable bash completion for interactive shells
RUN cat >> /root/.bashrc <<'EOF'
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi
EOF

SHELL ["/bin/bash", "-c"]

# Add pola completion
RUN mkdir -p /usr/share/bash-completion/completions \
 && pola completion bash > /usr/share/bash-completion/completions/pola

# polad reads polad.yaml from the working directory (mounted at runtime).
WORKDIR /pola

# Override the arguments at runtime if a different config path is needed.
ENTRYPOINT ["polad"]
CMD ["-f", "polad.yaml"]
